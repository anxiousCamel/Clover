{
  "name": "@clover/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arsenal de ferramentas do CloverOS — namespaces por departamento (git/, sys/, ...). Toda tool: Zod in/out, capability declarada, exec via Sandbox Tier 3.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clover/ast-index": "workspace:*",
    "@clover/contracts": "workspace:*",
    "@clover/sandbox": "workspace:*",
    "@clover/tool-abi": "workspace:*",
    "sql.js": "^1.14.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "vitest": "^2.1.9"
  }
}
