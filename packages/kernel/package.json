{
  "name": "@clover/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node dist/demo.js",
    "demo:dev": "tsx src/demo.ts"
  },
  "dependencies": {
    "@clover/capability": "workspace:*",
    "@clover/contracts": "workspace:*",
    "@clover/event-bus": "workspace:*",
    "@clover/executor": "workspace:*",
    "@clover/ir": "workspace:*",
    "@clover/tool-abi": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
