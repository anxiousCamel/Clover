{
  "name": "clover",
  "version": "0.1.0",
  "private": true,
  "description": "Clover Local AI Assistant — desktop-first, no cloud, no Docker",
  "scripts": {
    "dev": "pnpm --filter @clover/backend run dev & bash scripts/start-openclaude.sh & pnpm --filter @clover/ui run dev",
    "cli": "pnpm --filter @clover/backend run cli",
    "ui": "pnpm --parallel --filter @clover/backend --filter @clover/ui run dev",
    "build": "pnpm -r run build",
    "clover": "pnpm --filter @clover/cli run start",
    "clover:dev": "pnpm --filter @clover/cli run dev",
    "clover:setup": "pnpm --filter @clover/cli run start setup",
    "build:os": "tsc --build apps/cli/tsconfig.json",
    "test:os": "pnpm --filter \"@clover/*\" --filter @clover/cli -r run test",
    "health": "bash scripts/health-check.sh",
    "typecheck": "tsc --build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
